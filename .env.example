# ==============================================================================
# DPYB backend-ai-agent Environment Configuration Template
# Zero-cost strategy: Uses free-tier Google Gemini, Supabase, Redis/Upstash, Tavily
# ==============================================================================

# Application Environment (development, production, test)
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Google Gemini (Free Tier: Smart Routing & Multi-Key, 500+500 RPD per key $0 Zero-cost)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FALLBACK_API_KEY=your_teammate_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_LIGHT_MODEL=gemini-3.1-flash-lite
GEMMA_EMERGENCY_MODEL=gemma-4-31b-it
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# OpenAI API (Fallback / Alternative LLM: gpt-4o-mini)
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# Supabase PostgreSQL / Transaction Pooler (Multi-Schema & pgvector, Port 6543)
# 단일 Supabase Postgres 인스턴스 내 'agent' 스키마 독점 소유 ($0 무과금 원칙)
DB_USER=postgres.clhojanmfvjtdhhwilxm
DB_PASSWORD="your_db_password_here"
DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_SCHEMA=agent
# DATABASE_URL=postgresql+asyncpg://postgres.clhojanmfvjtdhhwilxm:password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# Supabase REST API (Free Tier: Optional / Legacy)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# Redis (Local Docker or Upstash Serverless Free Tier)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=3600


# Tavily Web Search (Free Tier: 1,000 requests/month, $0 Zero-cost)
# https://tavily.com/
TAVILY_API_KEY=tvly-your_tavily_api_key_here
TAVILY_API_URL=https://api.tavily.com/search

# National Library of Korea Open API (Aligned with backend-core-api: https://www.nl.go.kr/seoji/)
NL_API_CERT_KEY=your_national_library_cert_key_here
NL_API_SEARCH_URL=https://www.nl.go.kr/seoji/SearchApi.do
NL_API_TEST_URL=https://www.nl.go.kr/NL/search/openApi/search.do?key=203595bb8b92d6fc3e44180d05b6f3b161b35e2935bb75f871c7e9318d457dac&kwd=%ED%86%A0%EC%A7%80

# DPYB Core API (backend-core-api REST Endpoint & Shared JWT Auth)
CORE_API_BASE_URL=http://localhost:8000
CORE_API_TIMEOUT_SECONDS=5.0
JWT_SECRET_KEY=dont-paw-get-jwt-secret-change-in-prod-2026
JWT_ALGORITHM=HS256

# Book Sentence Scraping OCR: Uses Google Gemini Flash Vision ($0 Zero-cost, shared with GEMINI_API_KEY)
# No additional API keys needed for OCR!


# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Experience / Guest Mode Rate Limits & Role-based Circuit Breaker (70-80% safe buffer)
GUEST_CHAT_LIMIT=10
CIRCUIT_GUEST_RPM_LIMIT=60
CIRCUIT_GUEST_RPD_LIMIT=1400
CIRCUIT_MEMBER_RPM_LIMIT=120
CIRCUIT_MEMBER_RPD_LIMIT=4000
