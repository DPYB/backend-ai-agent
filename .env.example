# ==============================================================================
# DPYB backend-ai-agent Environment Configuration Template
# Zero-cost strategy: Uses free-tier Google Gemini, Supabase, Redis/Upstash, Tavily
# ==============================================================================

# Application Environment (development, production, test)
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Google Gemini (Free Tier: Google AI Studio)
# Model ID: gemini-3.8-flash
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# OpenAI API (Fallback / Alternative LLM: gpt-4o-mini)
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# Supabase Vector DB (Free Tier: PostgreSQL + pgvector)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# Redis (Local Docker or Upstash Serverless Free Tier)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=3600

# Tavily Web Search (Legacy Fallback)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# National Library of Korea Open API (국립중앙도서관 서지정보 API)
NATIONAL_LIBRARY_API_KEY=your_national_library_api_key_here
NATIONAL_LIBRARY_API_URL=https://www.nl.go.kr/NL/search/openApi/saseoApi.do

# DPYB Core API (backend-core-api REST Endpoint)
CORE_API_BASE_URL=http://localhost:8080
CORE_API_TIMEOUT_SECONDS=5.0

# NAVER Cloud CLOVA OCR General API V2
NAVER_CLOVA_API_URL=https://xxxx.apigw.ntruss.com/custom/v1/00000/xxxxxx/general
NAVER_CLOVA_SECRET_KEY=your_clova_secret_key_here

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
